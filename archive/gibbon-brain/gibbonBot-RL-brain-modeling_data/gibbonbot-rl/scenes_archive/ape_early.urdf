<?xml version="1.0"?>
<robot name="ape_robot">
  <!--
    Ape robot: floating torso + 4x RoArm M3 Pro limbs
    Prefixes: fl_ (front-left)  fr_ (front-right)
              bl_ (back-left)   br_ (back-right)
    Motor: STS3215 @ 12V — stall torque 2.94 Nm, max speed 6.28 rad/s
    Mesh paths are relative to this file's directory.
  -->

  <!-- ================================================================
       TORSO  (root link — MuJoCo gives it a freejoint automatically)
       box 30 × 20 × 10 cm, 1.0 kg
  ================================================================ -->
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <!-- solid box: ixx=(m/12)(h²+d²), iyy=(m/12)(l²+d²), izz=(m/12)(l²+h²) -->
      <inertia ixx="0.00417" ixy="0" ixz="0"
               iyy="0.00833" iyz="0"
               izz="0.01083"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.20 0.10"/></geometry>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.20 0.10"/></geometry>
    </collision>
  </link>


  <!-- ================================================================
       FRONT-LEFT ARM  (fl_)
  ================================================================ -->
  <joint name="torso_to_fl_base_link" type="fixed">
    <origin xyz="0.12 0.10 -0.05" rpy="0 0.785 0"/>
    <parent link="torso"/>
    <child link="fl_base_link"/>
  </joint>

  <link name="fl_base_link">
    <inertial>
      <origin xyz="-0.0068 0 -0.03" rpy="0 0 0"/>
      <mass value="0.2562183"/>
      <inertia ixx="0.00029211" ixy="0" ixz="0" iyy="0.00035719" iyz="0" izz="0.000349421"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/roarm_m3/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="silver"><color rgba="0.75 0.75 0.75 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/roarm_m3/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>

  <joint name="fl_base_link_to_link1" type="revolute">
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <parent link="fl_base_link"/>
    <child link="fl_link1"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-3.1416" upper="3.1416" effort="2.94" velocity="6.28"/>
  </joint>

  <link name="fl_link1">
    <inertial>
      <origin xyz="0 0 0.037" rpy="0 0 0"/>
      <mass value="0.0729177"/>
      <inertia ixx="4.68465E-05" ixy="0" ixz="0" iyy="3.32107E-05" iyz="0" izz="5.01023E-05"/>
