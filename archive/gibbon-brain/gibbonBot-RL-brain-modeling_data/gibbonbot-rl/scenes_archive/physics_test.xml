<?xml version="1.0" encoding="utf-8"?>
<!--
Physics sanity-check scene. Same floor friction & gravity as scene.xml.
Drops three balls from different heights with different elasticities so you can
visually compare the bouncing.

View with:
    python view_scene.py data/physics_test.xml
-->
<mujoco model="physics_test">
  <option gravity="0 0 -9.81" timestep="0.002" />
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0 0 0" />
  </visual>
  <worldbody>
    <geom name="floor" type="plane" pos="0 0 0" size="10 10 0.1"
          rgba="0.2 0.2 0.2 0.5" condim="3" friction="1.0 0.01 0.001"
          contype="1" conaffinity="31" />

    <!-- 1 m drop, default contact (squishy MuJoCo default) -->
    <body name="ball_default" pos="-0.4 0 1.0">
      <freejoint/>
      <geom type="sphere" size="0.05" mass="0.1" rgba="0.9 0.2 0.2 1"
            friction="1.0 0.005 0.0001" />
    </body>

    <!-- 1 m drop, stiff contact (more bouncy) -->
    <body name="ball_bouncy" pos="0 0 1.0">
      <freejoint/>
      <geom type="sphere" size="0.05" mass="0.1" rgba="0.2 0.9 0.2 1"
            friction="1.0 0.005 0.0001"
            solref="-2000 -50" solimp="0.95 0.99 0.001" />
    </body>

    <!-- 0.5 m drop, very stiff contact (rubber-ball-like) -->
    <body name="ball_rubber" pos="0.4 0 0.5">
      <freejoint/>
      <geom type="sphere" size="0.05" mass="0.1" rgba="0.2 0.4 1.0 1"
            friction="1.0 0.005 0.0001"
            solref="-5000 -10" solimp="0.99 0.999 0.0001" />
    </body>

    <camera name="fixed" pos="2.0 0 0.5" xyaxes="0 1 0 0 0 1" />
  </worldbody>
</mujoco>
