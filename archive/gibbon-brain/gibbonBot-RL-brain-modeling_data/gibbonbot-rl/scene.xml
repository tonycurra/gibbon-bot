<!-- Minimal scene for look.py. READ data/SCENE_GEOMETRY.md before editing
     any limb position, quat, or joint range. It documents:
       - units (SI, meters, radians)
       - the "base-to-base = inner face to inner face" formula (NOT centers)
       - real roarm M3 mesh dimensions
       - why we bake rotations into body quats and never use joint `ref`
     Current state (matches SCENE_GEOMETRY.md):
       - Compiler in radians.
       - Arm shoulders at y=±0.1711 → exactly 200 mm gap between the inner
         faces of the FL/FR base_link mounts.
       - Leg hips at x=-0.20, y=±0.10.
       - Back-leg link1 body quats baked with a 180° hip-yaw pre-rotation
         (quat (0, -0.7071068, 0, 0.7071068)) so qpos=0 is the rest pose.
       - Leg base_link mount mesh geoms rotated 180° around link2's long
         axis so the bracket orientation matches the arms.
       - Torso = two box geoms (torso_legs brown + torso_arms blue) in a
         single body, sized so every face is flush with the corresponding
         base_link mounting face. Z=98.5 mm tall (full base_link Z extent).
     Pre-mk2 4-limb architecture. Floor, one no-shadow directional light.
     No fog/haze/skybox/tree/headlight overrides. Used by look.py for
     visual inspection only; trainers use scene.xml. -->
<mujoco model="ape_robot">
  <compiler angle="radian"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <mesh name="base_link"   file="meshes/base_link.stl"   scale="0.001 0.001 0.001"/>
    <mesh name="link1"       file="meshes/link1.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="link2"       file="meshes/link2.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="link3"       file="meshes/link3.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="link4"       file="meshes/link4.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="link5"       file="meshes/link5.stl"       scale="0.001 0.001 0.001"/>
    <mesh name="gripper_link" file="meshes/gripper_link.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <default class="robot">
      <geom friction="2.0 0.01 0.001" condim="4"/>
    </default>
    <!-- Motor classes — see data/motors.md. Damping = τ_stall / ω_no_load.
         ST3235 (16): shoulder/hip yaw+pitch, elbow/knee, forearm/shin_roll.
         ST3215 (4):  wrist, ankle — same 2.94 N·m / 45 RPM as ST3235.
         ST3215-HS (4): gripper, foot — 1.96 N·m / 106 RPM (faster, less torque). -->
    <default class="st3235">    <joint damping="0.62"/></default>
    <default class="st3215">    <joint damping="0.62"/></default>
    <default class="st3215_hs"> <joint damping="0.18"/></default>
  </default>

  <contact>
    <!-- Disable limb-limb collisions so arms/legs pass through each other -->
    <exclude body1="fl_link1" body2="fr_link1"/>
    <exclude body1="bl_link1" body2="br_link1"/>
    <exclude body1="fl_link1" body2="bl_link1"/>
    <exclude body1="fl_link1" body2="br_link1"/>
    <exclude body1="fr_link1" body2="bl_link1"/>
    <exclude body1="fr_link1" body2="br_link1"/>
  </contact>

