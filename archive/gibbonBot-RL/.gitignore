__pycache__/
*.pyc
*.pyo
.DS_Store
*.egg-info/
dist/
build/
# Windows download metadata
*:Zone.Identifier
# MuJoCo runtime log
MUJOCO_LOG.TXT
MJMODEL.TXT

# MLflow tracking store — TRACKED (training data).

# ===== Project-Specific Ignores =====
# Evaluation results
*.npy
*.pkl

# ROS build artifacts
build/
devel/
install/
.catkin_workspace

# Large dataset files
*.h5
*.hdf5
*.tar
*.gz

# Model weights
*.ckpt
*.pt
*.pth

# Test output
test_*.py
coverage.xml
.htmlcov/
# (no global *.log — train.log etc. are training data, kept in git)

# Documentation build
docs/_build/
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc

# Specific to this project
/data/*
!/data/scene.xml
!/data/*.xml
!/data/*.md
!/data/meshes/
!/data/meshes/**
output/
results/

# Training checkpoints + history go to Object Storage, NOT git
# Large binary files that git cannot handle efficiently
*.npz
*.h5
*.hdf5

# MLflow tracking - goes to Object Storage
mlflow.db
mlflow.db.*
mlruns/

# Training artifacts in runs/ - goes to Object Storage
runs/*/mjx_*.npz
runs/*/rollout_*.npz
runs/*/rollouts/

# Training logs - goes to Object Storage
runs/*/train.log
runs/*/*.log

# MLflow remote sync files - goes to Object Storage
*.remote

# Keepers are curated checkpoints - still in git for reproducibility
# runs/*/keepers/

# Runtime cruft - ignored
runs/*/health.json
runs/*/latest.fingerprint.json
runs/*/monitor.log
runs/*/autopilot_state.json
runs/*/autopilot.log
runs/*/live_stats.json

# eval output (matplotlib)
reward.png

# Procedurally generated scenes (gen_trees.py output)
data/trees_forest.xml
.claude/
