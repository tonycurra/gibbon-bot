#!/usr/bin/env bash
# Liana — one command to start training + dashboard + log tail.
# Ctrl-C tears everything down cleanly.
#
# Usage:
#   ./liana go [task]          start trainer + dashboard for <task> (default: walk)
#   ./liana stop               stop trainer + dashboard
#   ./liana status             show what's running + tail of log
#   ./liana log "message"      append a dated entry to LIANA.md
#
# Tasks: walk (default — phase A is stand-and-survive), stand, walk_forward,
# turn_left, turn_right. The autopilot drives walk through phases A→D.
#
# Dashboard: http://localhost:8000/static/index.html
#   - Task dropdown + Envs input + Restart button (changes batch size requires
#     restart — MJX recompiles on shape change)
#   - Live sliders for motor speed, action smoothing, reward weights (hot-applied)
#   - Viewer renders env-0 qpos snapshot dumped every PPO batch

set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

TRAIN_LOG="$ROOT/train.log"
DASH_PID_FILE="$ROOT/runs/.dashboard.pid"
DASH_PORT="${LIANA_PORT:-8000}"
MLFLOW_PID_FILE="$ROOT/runs/.mlflow.pid"
MLFLOW_PORT="${LIANA_MLFLOW_PORT:-5000}"

_dash_alive() {
    [[ -f "$DASH_PID_FILE" ]] || return 1
    local pid; pid="$(cat "$DASH_PID_FILE")"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

_stop_dashboard() {
    if _dash_alive; then
        kill -TERM "$(cat "$DASH_PID_FILE")" 2>/dev/null || true
        sleep 1
        kill -KILL "$(cat "$DASH_PID_FILE")" 2>/dev/null || true
    fi
    pkill -f "uvicorn dashboard.server" 2>/dev/null || true
    rm -f "$DASH_PID_FILE"
}

_mlflow_alive() {
    [[ -f "$MLFLOW_PID_FILE" ]] || return 1
    local pid; pid="$(cat "$MLFLOW_PID_FILE")"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}
_stop_mlflow() {
    if _mlflow_alive; then
        kill -TERM "$(cat "$MLFLOW_PID_FILE")" 2>/dev/null || true
        sleep 1
        kill -KILL "$(cat "$MLFLOW_PID_FILE")" 2>/dev/null || true
    fi
    pkill -f "mlflow.* ui" 2>/dev/null || true
    pkill -f "mlflow.server" 2>/dev/null || true
    rm -f "$MLFLOW_PID_FILE"
}

_stop_all() {
    echo "[liana] stopping dashboard..."
    _stop_dashboard
    _stop_mlflow  # tear down any stray mlflow ui from older runs
    echo "[liana] stopping trainer..."
    "$ROOT/scripts/train_bg.sh" stop || true
}

cmd="${1:-go}"; shift || true

case "$cmd" in
    go)
        # Minimum-settings start: dashboard only, no trainer.
        # User triggers training (and picks env count) from the web UI.
        echo "[liana] cleaning any previous run..."
        _stop_all

        # Default active task so the dashboard / viewer have something to read.
        mkdir -p "$ROOT/runs"
        [[ -f "$ROOT/runs/.active_task" ]] || echo -n "walk" > "$ROOT/runs/.active_task"

        echo "[liana] launching dashboard on :$DASH_PORT..."
        # --log-level warning silences the firehose of GET access logs.
        # An access-log filter in server.py drops the spammiest endpoints
        # even when log level is raised, so terminal only shows real events.
        nohup "$ROOT/.venv/bin/python" -m uvicorn dashboard.server:app \
            --host 0.0.0.0 --port "$DASH_PORT" --log-level warning \
            >"$ROOT/runs/dashboard.log" 2>&1 </dev/null &
        echo $! >"$DASH_PID_FILE"
        disown || true

        ( sleep 2 && xdg-open "http://localhost:$DASH_PORT/static/index.html" >/dev/null 2>&1 ) &

        "$0" log "started: dashboard only (no trainer)  → http://localhost:$DASH_PORT/static/index.html"

        echo "[liana] ─────────────────────────────────────────────────────"
        echo "[liana] services up:"
        echo "[liana]   dashboard → http://localhost:$DASH_PORT/static/index.html"
        echo "[liana]   Ctrl-C stops EVERYTHING."
        echo "[liana] ─────────────────────────────────────────────────────"

        # Trap any way of dying so children never outlive the script.
        # EXIT covers normal exits, errors and `set -e` failures;
        # INT/TERM/HUP cover Ctrl-C, kill, terminal close.
        cleanup() {
            # Guard against re-entry — if trap fires multiple times during teardown.
            [[ -n "${_LIANA_CLEANED:-}" ]] && return 0
            _LIANA_CLEANED=1
            echo
            echo "[liana] caught signal — stopping everything..."
            _stop_all
        }
        trap cleanup EXIT INT TERM HUP

        tail -F "$ROOT/runs/dashboard.log" 2>/dev/null || true
        ;;

    stop)
        _stop_all
        ;;

    status)
        echo "── trainer ──"
        "$ROOT/scripts/train_bg.sh" status || true
        echo
        echo "── dashboard ──"
        if _dash_alive; then
            echo "RUNNING  pid=$(cat "$DASH_PID_FILE")  url=http://localhost:$DASH_PORT/static/index.html"
        else
            echo "STOPPED"
        fi
        ;;

    log)
        msg="${1:-}"
        if [[ -z "$msg" ]]; then
            echo "usage: $0 log \"message\"" >&2
            exit 2
        fi
        ts="$(date '+%Y-%m-%d %H:%M')"
        {
            printf '\n## %s\n%s\n' "$ts" "$msg"
        } >> "$ROOT/LIANA_LOG.md"
        echo "[liana] logged → LIANA_LOG.md"
        ;;

    *)
        echo "usage: $0 {go [task]|stop|status|log \"msg\"}" >&2
        exit 2
        ;;
esac
