#!/usr/bin/env bash
# Liana — one command to start training + dashboard + log tail.
# Ctrl-C tears everything down cleanly.
#
# Usage:
#   ./liana go [task]          start trainer + dashboard for <task> (default: walk)
#   ./liana stop               stop trainer + dashboard
#   ./liana status             show what's running + tail of log
#   ./liana log "message"      append a dated entry to LIANA.md
#
# Tasks: walk (default — phase A is stand-and-survive), stand, walk_forward,
# turn_left, turn_right. The autopilot drives walk through phases A→D.
#
# Dashboard: http://localhost:8000/static/index.html
#   - Task dropdown + Envs input + Restart button (changes batch size requires
#     restart — MJX recompiles on shape change)
#   - Live sliders for motor speed, action smoothing, reward weights (hot-applied)
#   - Viewer renders env-0 qpos snapshot dumped every PPO batch

set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

TRAIN_LOG="$ROOT/train.log"
DASH_PID_FILE="$ROOT/runs/.dashboard.pid"
DASH_PORT="${LIANA_PORT:-8000}"

_dash_alive() {
    [[ -f "$DASH_PID_FILE" ]] || return 1
    local pid; pid="$(cat "$DASH_PID_FILE")"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

_stop_dashboard() {
    if _dash_alive; then
        kill -TERM "$(cat "$DASH_PID_FILE")" 2>/dev/null || true
        sleep 1
        kill -KILL "$(cat "$DASH_PID_FILE")" 2>/dev/null || true
    fi
    pkill -f "uvicorn dashboard.server" 2>/dev/null || true
    rm -f "$DASH_PID_FILE"
}

_stop_all() {
    echo "[liana] stopping dashboard..."
    _stop_dashboard
    echo "[liana] stopping trainer..."
    "$ROOT/scripts/train_bg.sh" stop || true
}

cmd="${1:-go}"; shift || true

case "$cmd" in
    go)
        task="${1:-walk}"; shift || true
        echo "[liana] task=$task — cleaning any previous run"
        _stop_all

        # Record active task so the dashboard knows what to render.
        mkdir -p "$ROOT/runs"
        echo -n "$task" > "$ROOT/runs/.active_task"

        echo "[liana] starting trainer..."
        "$ROOT/scripts/train_bg.sh" start "$task" "$@"

        # Wait for log to appear.
        for _ in 1 2 3 4 5; do
            [[ -s "$TRAIN_LOG" ]] && break
            sleep 1
        done

        echo "[liana] launching dashboard on :$DASH_PORT..."
        nohup "$ROOT/.venv/bin/python" -m uvicorn dashboard.server:app \
            --host 0.0.0.0 --port "$DASH_PORT" \
            >"$ROOT/runs/dashboard.log" 2>&1 </dev/null &
        echo $! >"$DASH_PID_FILE"
        disown || true

        # Try to open the browser (no-op if no GUI / no xdg-open).
        ( sleep 2 && xdg-open "http://localhost:$DASH_PORT/static/index.html" >/dev/null 2>&1 ) &

        "$0" log "started: task=$task  (dashboard http://localhost:$DASH_PORT/static/index.html)"

        echo "[liana] ─────────────────────────────────────────────────────"
        echo "[liana] trainer + dashboard running."
        echo "[liana]   dashboard → http://localhost:$DASH_PORT/static/index.html"
        echo "[liana]   tailing  → $TRAIN_LOG"
        echo "[liana]   Ctrl-C stops everything."
        echo "[liana] ─────────────────────────────────────────────────────"

        trap '_stop_all; exit 0' INT TERM
        tail -F "$TRAIN_LOG" 2>/dev/null || true
        ;;

    stop)
        _stop_all
        ;;

    status)
        echo "── trainer ──"
        "$ROOT/scripts/train_bg.sh" status || true
        echo
        echo "── dashboard ──"
        if _dash_alive; then
            echo "RUNNING  pid=$(cat "$DASH_PID_FILE")  url=http://localhost:$DASH_PORT/static/index.html"
        else
            echo "STOPPED"
        fi
        ;;

    log)
        msg="${1:-}"
        if [[ -z "$msg" ]]; then
            echo "usage: $0 log \"message\"" >&2
            exit 2
        fi
        ts="$(date '+%Y-%m-%d %H:%M')"
        {
            printf '\n## %s\n%s\n' "$ts" "$msg"
        } >> "$ROOT/LIANA.md"
        echo "[liana] logged → LIANA.md"
        ;;

    *)
        echo "usage: $0 {go [task]|stop|status|log \"msg\"}" >&2
        exit 2
        ;;
esac
