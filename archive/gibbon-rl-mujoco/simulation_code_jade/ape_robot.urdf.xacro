<?xml version="1.0"?>
<robot name="robotic_ape" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mesh_base" value="."/>
  <xacro:include filename="roarm_m3_macro.xacro"/>

  <mujoco>
    <option integrator="RK4" timestep="0.001"/>
    <compiler discardvisual="false" meshdir="meshes/roarm_m3"/>
    
    <contact>
      <exclude body1="torso" body2="fl_base_link"/>
      <exclude body1="torso" body2="fr_base_link"/>
      <exclude body1="torso" body2="bl_base_link"/>
      <exclude body1="torso" body2="br_base_link"/>
    </contact>
  </mujoco>

  <link name="torso">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0058" ixy="0" ixz="0" iyy="0.0121" iyz="0" izz="0.0163"/>
    </inertial>
    <visual>
      <geometry><box size="0.30 0.20 0.08"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.30 0.20 0.08"/></geometry>
    </collision>
  </link>

  <xacro:roarm_m3 prefix="fl_" parent="torso" mesh_path="${mesh_base}">
    <origin xyz="0.10 0.09 -0.04" rpy="3.1415 0.15 0.15"/>
  </xacro:roarm_m3>

  <xacro:roarm_m3 prefix="fr_" parent="torso" mesh_path="${mesh_base}">
    <origin xyz="0.10 -0.09 -0.04" rpy="3.1415 0.15 -0.15"/>
  </xacro:roarm_m3>

  <xacro:roarm_m3 prefix="bl_" parent="torso" mesh_path="${mesh_base}">
    <origin xyz="-0.10 0.09 -0.04" rpy="3.1415 -0.15 0.15"/>
  </xacro:roarm_m3>

  <xacro:roarm_m3 prefix="br_" parent="torso" mesh_path="${mesh_base}">
    <origin xyz="-0.10 -0.09 -0.04" rpy="3.1415 -0.15 -0.15"/>
  </xacro:roarm_m3>

</robot>